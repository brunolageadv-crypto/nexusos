# Firebase — copie do console Firebase > Configurações do projeto
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# GitHub Pages — base path do repositório
# Se o repo se chama "nexusos": VITE_BASE_PATH=/nexusos/
# Se for Pages com domínio próprio ou repo <username>.github.io: VITE_BASE_PATH=/
VITE_BASE_PATH=/nexusos/
